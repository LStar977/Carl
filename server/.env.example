# Carl backend configuration. Copy to .env and fill in what you have.
# The server runs fully without any of these (mock fallbacks), so you can
# develop the app immediately, then flip on real data as keys arrive.

PORT=8787

# Anthropic / Claude — used for résumé parsing, fit scoring, and drafting
# applications. Without it, deterministic heuristics are used instead.
ANTHROPIC_API_KEY=
CARL_MODEL=claude-sonnet-4-6
CARL_FAST_MODEL=claude-haiku-4-5-20251001

# Adzuna job search API (https://developer.adzuna.com). Commercial use needs an
# agreement with Adzuna before launch.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS API (https://developer.usajobs.gov) — US federal listings.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Apply engine: "dry-run" prepares + records applications but never submits to a
# real employer (safe default). "live" actually POSTs Tier-A (Greenhouse/Lever)
# applications. Keep dry-run until you intend to apply for real.
APPLY_MODE=dry-run

# Free applications granted to each new user (matches the "first 3 free" paywall).
FREE_CREDITS=3

# App Store receipt validation. "off" trusts the client (dev / simulator local
# StoreKit). "on" cryptographically verifies the StoreKit 2 signed transaction
# against Apple's root before granting credits — use for Sandbox/TestFlight/App
# Store. Requires the Apple root cert below.
APPSTORE_VERIFY=off
APPLE_BUNDLE_ID=com.carlapp.Carl
# Download "Apple Root CA - G3" (PEM) from https://www.apple.com/certificateauthority/
APPLE_ROOT_CA_PATH=certs/AppleRootCA-G3.pem
