# Carl backend configuration. Copy to .env and fill in what you have.
# The server runs fully without any of these (mock fallbacks), so you can
# develop the app immediately, then flip on real data as keys arrive.

PORT=8787

# Anthropic / Claude — used for résumé parsing, fit scoring, and drafting
# applications. Without it, deterministic heuristics are used instead.
ANTHROPIC_API_KEY=
CARL_MODEL=claude-sonnet-4-6
CARL_FAST_MODEL=claude-haiku-4-5-20251001

# Free public-ATS discovery (Greenhouse / Lever / Ashby public job boards).
# REAL listings with no API key and no commercial agreement — this is the
# default, primary, $0 job source. Grow the company list in
# src/data/boards.js to widen coverage. Set to "off" to disable.
ATS_ENABLED=on
# Optional: path to a JSON file of extra board tokens to merge in, shaped
# { "greenhouse": [...], "lever": [...], "ashby": [...] }. Public crawls cover
# 20k+ companies — but large lists need the background ingestion worker, not
# live per-search fetches (see docs/job-sources-and-coverage.md).
ATS_BOARDS_PATH=

# Background ingestion worker. When "on", the server crawls all boards into a
# searchable index on startup and every INGEST_INTERVAL_MIN minutes, so searches
# are instant and scale to a huge token list. INGEST_CONCURRENCY bounds parallel
# fetches. Run a one-off crawl to validate a token list with: npm run ingest
INGEST_ENABLED=off
INGEST_INTERVAL_MIN=360
INGEST_CONCURRENCY=20

# Adzuna job search API (https://developer.adzuna.com) — OPTIONAL extra breadth
# beyond the free ATS boards. Commercial use needs a (paid) agreement with
# Adzuna; leave blank to launch on the free boards alone.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS API (https://developer.usajobs.gov) — US federal listings.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Apply engine: "dry-run" prepares + records applications but never submits to a
# real employer (safe default). "live" actually POSTs Tier-A (Greenhouse/Lever)
# applications. Keep dry-run until you intend to apply for real.
APPLY_MODE=dry-run

# Free applications granted to each new user (matches the "first 3 free" paywall).
FREE_CREDITS=3

# App Store receipt validation. "off" trusts the client (dev / simulator local
# StoreKit). "on" cryptographically verifies the StoreKit 2 signed transaction
# against Apple's root before granting credits — use for Sandbox/TestFlight/App
# Store. Requires the Apple root cert below.
APPSTORE_VERIFY=off
APPLE_BUNDLE_ID=com.carlapp.Carl
# Download "Apple Root CA - G3" (PEM) from https://www.apple.com/certificateauthority/
APPLE_ROOT_CA_PATH=certs/AppleRootCA-G3.pem
